{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moldacobrasil",
  "main": "src/main.py",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
